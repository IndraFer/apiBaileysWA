# ─────────────────────────────────────────────────────────────
# Build stage — Bun transpiles TypeScript and resolves the tsconfig
# path aliases (@/*). The output is a plain ESM bundle with all
# packages left external, so the runtime stage needs no TS loader.
# ─────────────────────────────────────────────────────────────
FROM oven/bun:latest AS build
WORKDIR /app

COPY . .
RUN bun build src/index.ts --target=node --outfile=dist/server.mjs --packages=external

# ─────────────────────────────────────────────────────────────
# Runtime stage — native Node.js
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app

# Install dependencies. The build toolchain is required for native modules
# (sharp, libsignal); it is installed and removed in the same layer so the
# final image stays lean.
COPY package.json package-lock.json* ./
RUN apk add --no-cache --virtual .build-deps python3 make g++ \
 && npm install --no-audit --no-fund \
 && apk del .build-deps

# Compiled bundle plus the static dashboard assets (read at runtime from
# <cwd>/src/dashboard-ui).
COPY --from=build /app/dist ./dist
COPY --from=build /app/src/dashboard-ui ./src/dashboard-ui

# Create required directories
RUN mkdir -p sessions media logs data

# Expose port
EXPOSE 3000

# Health check (respects PORT so a custom port does not report unhealthy)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider "http://localhost:${PORT:-3000}/status" || exit 1

CMD ["node", "dist/server.mjs"]
