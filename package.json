{
	"name": "api-baileys-wa-hono",
	"version": "1.16.1",
	"type": "module",
	"description": "WhatsApp REST API powered by Baileys WA Sockets with multi-session support, Dual-Runtime support, Redis integration, and broadcast queuing.",
	"author": "indrafer",
	"license": "MIT",
	"module": "src/index.ts",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"dev:node": "tsx watch src/index.ts",
		"start:node": "tsx src/index.ts",
		"build-check": "bunx tsc --noEmit",
		"lint": "bunx @biomejs/biome check src/ --diagnostic-level=error",
		"lint:all": "bunx @biomejs/biome check src/",
		"format": "bunx @biomejs/biome check --write src/",
		"manage-api-keys": "LOG_LEVEL=warn bun scripts/manage-api-keys.ts",
		"manage-api-keys:node": "LOG_LEVEL=warn tsx scripts/manage-api-keys.ts",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"@hono/zod-openapi": "^1.6.3",
		"@whiskeysockets/baileys": "7.0.0-rc14",
		"bcryptjs": "^3.0.3",
		"hono": "^4.13.16",
		"lru-cache": "^11.5.3",
		"node-cache": "^5.1.2",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"qrcode": "^1.5.4",
		"redis": "^6.3.1",
		"sharp": "^0.35.5",
		"swagger-ui-dist": "^5.34.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/qrcode": "^1.5.6",
		"bun-types": "latest",
		"dompurify": "^3.4.17",
		"tsx": "^4.23.15"
	}
}
